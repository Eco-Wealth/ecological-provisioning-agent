{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.org/schemas/intent.schema.json",
  "title": "ProvisioningIntent",
  "type": "object",
  "required": [
    "id",
    "summary",
    "place",
    "desired_outcome",
    "stakeholders",
    "constraints",
    "unknowns"
  ],
  "properties": {
    "id": {
      "type": "string"
    },
    "summary": {
      "type": "string"
    },
    "place": {
      "type": "string"
    },
    "problem": {
      "type": "string"
    },
    "desired_outcome": {
      "type": "string"
    },
    "stakeholders": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "constraints": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "unknowns": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "candidate_work": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "proof_needed": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "risk_level": {
      "enum": [
        "low",
        "medium",
        "high",
        "unknown"
      ]
    }
  }
}
