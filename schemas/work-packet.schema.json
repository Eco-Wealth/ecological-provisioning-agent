{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "WorkPacket",
  "type": "object",
  "required": [
    "id",
    "title",
    "context",
    "task",
    "skills_needed",
    "safety_notes",
    "proof_required",
    "acceptance_criteria"
  ],
  "properties": {
    "id": {
      "type": "string"
    },
    "title": {
      "type": "string"
    },
    "context": {
      "type": "string"
    },
    "task": {
      "type": "string"
    },
    "location_assumptions": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "materials": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "tools": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "skills_needed": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "difficulty": {
      "enum": [
        "low",
        "medium",
        "high",
        "unknown"
      ]
    },
    "safety_notes": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "proof_required": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "acceptance_criteria": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "next_action": {
      "type": "string"
    }
  }
}
