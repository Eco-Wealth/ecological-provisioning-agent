{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "PrincipleLensResult",
  "type": "object",
  "required": [
    "lens",
    "alignment",
    "reason",
    "evidence_needed"
  ],
  "properties": {
    "lens": {
      "type": "string"
    },
    "alignment": {
      "enum": [
        "strong",
        "partial",
        "weak",
        "unknown"
      ]
    },
    "reason": {
      "type": "string"
    },
    "evidence_needed": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  }
}
